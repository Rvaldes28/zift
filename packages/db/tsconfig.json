{
  "compilerOptions": {
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "target": "ES2022"
  },
  "include": ["drizzle.config.ts", "src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
