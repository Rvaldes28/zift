# PostgreSQL local via Homebrew
DATABASE_URL=postgresql://localhost:5432/ziftlab_dev

# Secreto de Payload — generar uno propio: openssl rand -hex 32
PAYLOAD_SECRET=change_me_local_secret

# URL pública del servidor Payload
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origen permitido para CORS (web Astro)
WEB_URL=http://localhost:4321

# MinIO local — storage S3-compatible para media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=payload-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
