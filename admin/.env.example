ADMIN_ENFORCE_2FA_FOR_SENSITIVE=true
ADMIN_CSRF_SECRET=
ADMIN_ALLOWED_ORIGINS=https://<codespace>-3000.<forwarding-domain>,https://<codespace>-4321.<forwarding-domain>
ADMIN_PREVIEW_TOKEN=
