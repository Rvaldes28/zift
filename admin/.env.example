# Dashboard propio
NODE_ENV=development
ADMIN_APP_URL=https://<codespace>-3000.<forwarding-domain>
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ziftlab_admin_dev
ADMIN_SESSION_DAYS=14
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_IP_MAX_FAILED_ATTEMPTS=10
ADMIN_IP_WINDOW_MINUTES=15
ADMIN_IP_BLOCK_MINUTES=60
ADMIN_PASSWORD_MIN_LENGTH=12
ADMIN_ARGON2_MEMORY=65536
ADMIN_ARGON2_TIME=3
ADMIN_ARGON2_PARALLELISM=1
