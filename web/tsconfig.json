{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // Sin baseUrl (deprecado en TS 6+): los paths son relativos a este archivo.
    // Astro resuelve estos alias también en runtime (imports de valor).
    "paths": {
      "@/*": ["./src/*"],
      "@cms/types": ["../cms/src/payload-types.ts"]
    }
  }
}
