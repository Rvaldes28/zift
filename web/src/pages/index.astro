---
import '../styles/global.css'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>ZiftLab</title>
    <meta name="description" content="ZiftLab — agencia digital. Sitio en construcción." />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <main
      class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center gap-4 px-6 text-center"
    >
      <p class="text-sm tracking-widest text-slate-400 uppercase">Fase 0 — Setup local</p>
      <h1 class="text-5xl font-bold">ZiftLab</h1>
      <p class="text-lg text-slate-300">
        Entorno local funcionando: Astro + Tailwind CSS. El contenido llegará desde Payload CMS en
        las siguientes fases.
      </p>
    </main>
  </body>
</html>
