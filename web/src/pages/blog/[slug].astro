---
/**
 * Detalle de artículo (FASE 6). Cabecera con la línea de registro del blog
 * (autor · fecha · tiempo de lectura), prosa en ancho de lectura, artículos
 * relacionados por categoría y Schema.org Article para resultados enriquecidos.
 */
import PayloadImage from '@/components/PayloadImage.astro'
import CTASection from '@/components/sections/CTASection.astro'
import PostGrid from '@/components/sections/PostGrid.astro'
import RichText from '@/components/sections/RichText.astro'
import SectionIntro from '@/components/sections/SectionIntro.astro'
import Container from '@/components/ui/Container.astro'
import Heading from '@/components/ui/Heading.astro'
import Section from '@/components/ui/Section.astro'
import Text from '@/components/ui/Text.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatDateLong, postAuthor, postCategories, readingTimeMinutes } from '@/lib/blog'
import { getMediaUrl } from '@/lib/media'
import { getCachedGlobal, getCollection } from '@/lib/payload'
import type { Post } from '@cms/types'

export async function getStaticPaths() {
  // depth 2: resuelve categorías, portada y el autor con su foto
  const posts = await getCollection('posts', { sort: '-publishedAt', limit: 200, depth: 2 })
  return posts.docs
    .filter((post): post is Post & { slug: string } => Boolean(post.slug))
    .map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

// El tipo de props lo infiere Astro desde getStaticPaths
const { post } = Astro.props

const settings = await getCachedGlobal('site-settings')
const categories = postCategories(post)
const author = postAuthor(post)
const minutes = readingTimeMinutes(post.content)
const publishedAt = post.publishedAt ?? post.createdAt

// Relacionados: comparten categoría; se completa con recientes si faltan
const categoryIds = categories.map((category) => category.id)
const bySharedCategory =
  categoryIds.length > 0
    ? await getCollection('posts', {
        sort: '-publishedAt',
        limit: 3,
        where: { categories: { in: categoryIds }, id: { not_equals: post.id } },
      })
    : null
let related = bySharedCategory?.docs ?? []
if (related.length < 3) {
  const recent = await getCollection('posts', { sort: '-publishedAt', limit: 6 })
  const seen = new Set([post.id, ...related.map((doc) => doc.id)])
  related = [...related, ...recent.docs.filter((doc) => !seen.has(doc.id))].slice(0, 3)
}

const canonical = new URL(Astro.url.pathname, Astro.site).href
const coverUrl = getMediaUrl(post.meta?.image) ?? getMediaUrl(post.coverImage)

// Schema.org Article para resultados enriquecidos de Google
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  ...(coverUrl && { image: [coverUrl] }),
  datePublished: publishedAt,
  dateModified: post.updatedAt,
  ...(author && { author: [{ '@type': 'Person', name: author.name, jobTitle: author.role }] }),
  publisher: { '@type': 'Organization', name: settings.siteName },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
}
---

<BaseLayout
  absoluteTitle={post.meta?.title ?? undefined}
  title={post.meta?.title ? undefined : post.title}
  description={post.meta?.description ?? post.excerpt}
  ogImage={coverUrl}
  article={{ publishedTime: publishedAt, modifiedTime: post.updatedAt }}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')}
  />

  {/* Cabecera del artículo */}
  <Section class="md:pb-16">
    <Container size="narrow">
      {
        categories.length > 0 && (
          <p class="flex flex-wrap items-center gap-2.5 font-mono text-xs tracking-[0.18em] uppercase">
            <span class="size-2 shrink-0 bg-zift" aria-hidden="true" />
            {categories.map((category, index) => (
              <>
                {index > 0 && <span class="text-muted">·</span>}
                <a
                  href={`/blog/categoria/${category.slug}`}
                  class="text-muted transition-colors hover:text-zift"
                >
                  {category.title}
                </a>
              </>
            ))}
          </p>
        )
      }
      <Heading as="h1" size="display" class="mt-6">
        {post.title}
      </Heading>
      <Text size="lead" muted class="mt-6">
        {post.excerpt}
      </Text>

      {/* Línea de registro: autor · fecha · tiempo de lectura */}
      <div
        class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-line pt-6 font-mono text-xs tracking-[0.14em] text-muted uppercase"
      >
        {
          author && (
            <div class="flex items-center gap-3 normal-case">
              <PayloadImage
                media={author.photo}
                class="size-9 rounded-full object-cover"
                sizes="36px"
              />
              <div>
                <p class="font-sans text-sm font-medium tracking-normal text-ink">{author.name}</p>
                <p class="mt-0.5 tracking-[0.14em] uppercase">{author.role}</p>
              </div>
            </div>
          )
        }
        <time datetime={publishedAt}>{formatDateLong(publishedAt)}</time>
        <span>{minutes} min de lectura</span>
      </div>
    </Container>
    <Container>
      <PayloadImage
        media={post.coverImage}
        priority
        class="mt-14 w-full rounded-xl border border-line object-cover"
        sizes="(min-width: 1152px) 1152px, 100vw"
      />
    </Container>
  </Section>

  {/* Cuerpo del artículo */}
  <Section tone="surface">
    <Container size="narrow">
      <RichText content={post.content} />
    </Container>
  </Section>

  {/* Artículos relacionados */}
  {
    related.length > 0 && (
      <Section>
        <Container>
          <SectionIntro eyebrow="Sigue leyendo" title="Artículos relacionados" />
          <PostGrid posts={related} class="mt-12" />
        </Container>
      </Section>
    )
  }

  {/* CTA final */}
  <CTASection
    title="¿Quieres aplicar esto en tu negocio?"
    text="Agenda una asesoría gratuita de 30 minutos. Te decimos qué haríamos con tu proyecto y qué resultados puedes esperar."
    cta={{ label: 'Agenda una asesoría', href: '/contacto' }}
  />
</BaseLayout>
