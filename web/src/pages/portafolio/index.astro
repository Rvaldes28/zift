---
/**
 * Portafolio (FASE 5): archivo de casos de éxito con filtro por servicio.
 * El filtro es mejora progresiva: sin JS se ven todos los casos; con JS
 * los chips filtran en la página y sincronizan ?servicio= para compartir.
 */
import CTASection from '@/components/sections/CTASection.astro'
import ProjectCard from '@/components/sections/ProjectCard.astro'
import SectionIntro from '@/components/sections/SectionIntro.astro'
import Container from '@/components/ui/Container.astro'
import Section from '@/components/ui/Section.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection, resolveDocs } from '@/lib/payload'
import type { Service } from '@cms/types'

const projects = await getCollection('projects', { sort: '-completedAt', limit: 100 })

// Chips solo de servicios con al menos un caso, en el orden del catálogo
const servicesBySlug = new Map<string, Service>()
for (const project of projects.docs) {
  for (const service of resolveDocs<Service>(project.services)) {
    if (service.slug) servicesBySlug.set(service.slug, service)
  }
}
const filterServices = [...servicesBySlug.values()].sort((a, b) => (a.order ?? 0) - (b.order ?? 0))

const projectServiceSlugs = (project: (typeof projects.docs)[number]): string =>
  resolveDocs<Service>(project.services)
    .map((service) => service.slug)
    .filter(Boolean)
    .join(' ')

const chipClasses =
  'inline-flex h-9 items-center rounded-md border border-line bg-white px-4 font-mono text-xs tracking-[0.14em] uppercase text-muted transition-colors hover:border-ink hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white'
---

<BaseLayout
  title="Portafolio"
  description="Casos de éxito de ZiftLab: proyectos reales de desarrollo web, e-commerce, automatización y marketing con resultados medibles."
>
  <Section class="md:pb-16">
    <Container>
      <SectionIntro
        eyebrow={`Portafolio · ${projects.totalDocs} ${projects.totalDocs === 1 ? 'caso' : 'casos'}`}
        title="Casos de éxito"
        text="Proyectos reales con métricas reales: qué problema traía el cliente, qué construimos y cuánto mejoró su negocio."
        as="h1"
        size="display"
      />
    </Container>
  </Section>

  <Section tone="surface">
    <Container>
      {
        filterServices.length > 1 && (
          <div
            class="mb-10 flex flex-wrap gap-2"
            role="group"
            aria-label="Filtrar casos por servicio"
          >
            <button type="button" data-filter="todos" aria-pressed="true" class={chipClasses}>
              Todos
            </button>
            {filterServices.map((service) => (
              <button
                type="button"
                data-filter={service.slug}
                aria-pressed="false"
                class={chipClasses}
              >
                {service.title}
              </button>
            ))}
          </div>
        )
      }
      <p id="filter-status" class="sr-only" aria-live="polite"></p>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          projects.docs.map((project) => (
            <li data-services={projectServiceSlugs(project)}>
              <ProjectCard project={project} class="h-full" />
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <CTASection
    title="¿Tu proyecto es el siguiente caso?"
    text="Agenda una asesoría gratuita de 30 minutos. Te decimos qué haríamos y qué resultados puedes esperar."
    cta={{ label: 'Agenda una asesoría', href: '/contacto' }}
  />
</BaseLayout>

<script>
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('button[data-filter]'),
  )
  const cards = Array.from(document.querySelectorAll<HTMLElement>('li[data-services]'))
  const status = document.getElementById('filter-status')

  const applyFilter = (slug: string): void => {
    for (const button of filterButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === slug))
    }
    let visible = 0
    for (const card of cards) {
      const match = slug === 'todos' || (card.dataset.services ?? '').split(' ').includes(slug)
      card.hidden = !match
      if (match) visible += 1
    }
    if (status) status.textContent = `Mostrando ${visible} ${visible === 1 ? 'caso' : 'casos'}`
    const url = new URL(window.location.href)
    if (slug === 'todos') url.searchParams.delete('servicio')
    else url.searchParams.set('servicio', slug)
    history.replaceState(null, '', url)
  }

  for (const button of filterButtons) {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'todos'))
  }

  // Estado inicial compartible: /portafolio?servicio=e-commerce
  const initial = new URL(window.location.href).searchParams.get('servicio')
  if (initial && filterButtons.some((button) => button.dataset.filter === initial)) {
    applyFilter(initial)
  }
</script>
