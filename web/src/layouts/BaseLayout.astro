---
/**
 * Layout principal: <head> con SEO, header y footer desde la API publica.
 * Los globals se piden en paralelo y quedan memoizados durante el build.
 */
import '@/styles/global.css'

import Analytics from '@/components/Analytics.astro'
import CookieConsent from '@/components/CookieConsent.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import JsonLd from '@/components/JsonLd.astro'
import SEO from '@/components/SEO.astro'
import WhatsAppButton from '@/components/WhatsAppButton.astro'
import { CONSENT_KEY } from '@/lib/consent'
import { getMediaUrl } from '@/lib/media'
import { getCachedGlobal } from '@/lib/api'
import { organizationSchema } from '@/lib/schema'

interface Props {
  /** Título de la página; se compone como "Título | SiteName". Si falta, se usa el SEO por defecto del CMS. */
  title?: string
  /** Título ya compuesto (p. ej. meta.title del plugin SEO) — se usa tal cual, sin añadir "| SiteName" */
  absoluteTitle?: string
  canonicalUrl?: string
  description?: string
  /** URL absoluta de la imagen OG; default: ogImage de Ajustes del sitio */
  ogImage?: string | null
  ogTitle?: string | null
  ogDescription?: string | null
  noindex?: boolean
  robotsDirectives?: string[]
  schemaJsonLd?: Record<string, unknown> | Record<string, unknown>[] | null
  /** Posts del blog: og:type article con sus fechas de publicación/edición */
  article?: { publishedTime?: string; modifiedTime?: string }
}

const {
  title,
  absoluteTitle,
  canonicalUrl,
  description,
  ogDescription,
  ogImage,
  ogTitle,
  noindex = false,
  robotsDirectives,
  schemaJsonLd,
  article,
} = Astro.props

const [settings, header, footer] = await Promise.all([
  getCachedGlobal('site-settings'),
  getCachedGlobal('header'),
  getCachedGlobal('footer'),
])

const siteName = settings.siteName
const defaultTitle =
  settings.defaultSeo?.title ?? (settings.tagline ? `${siteName} — ${settings.tagline}` : siteName)

const seoTitle = absoluteTitle ?? (title ? `${title} | ${siteName}` : defaultTitle)
const seoDescription = description ?? settings.defaultSeo?.description ?? undefined
const seoImage = ogImage ?? getMediaUrl(settings.defaultSeo?.ogImage)

// Schema Organization en todas las páginas (FASE 8); LocalBusiness solo lo
// añaden el home y /contacto vía slot="head"
const site = Astro.site ?? new URL(Astro.url.origin)

// Bloqueo previo de cookies (FASE 16): Consent Mode v2 arranca en denied de
// forma síncrona, antes de cualquier script de analítica (GA4/Clarity, FASE 12
// — respetan este estado sin cambios). Va como texto (set:html) para que
// Astro no lo procese ni lo difiera; la clave viene de lib/consent.ts.
const consentInit = `
window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});
try{
  var c = JSON.parse(localStorage.getItem('${CONSENT_KEY}') || 'null');
  if (c && c.v === 1) {
    gtag('consent','update',{
      analytics_storage: c.analytics ? 'granted' : 'denied',
      ad_storage: c.marketing ? 'granted' : 'denied',
      ad_user_data: c.marketing ? 'granted' : 'denied',
      ad_personalization: c.marketing ? 'granted' : 'denied'
    });
  }
} catch (e) {}
`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={consentInit} />
    <script is:inline>
      // Activa el scroll-reveal solo si va a poder ejecutarse; así el contenido
      // nunca queda oculto sin JS ni con movimiento reducido.
      if (
        'IntersectionObserver' in window &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('js-reveal')
      }
    </script>
    <SEO
      title={seoTitle}
      description={seoDescription}
      canonical={canonicalUrl}
      image={seoImage}
      siteName={siteName}
      noindex={noindex}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      robotsDirectives={robotsDirectives}
      type={article ? 'article' : 'website'}
      publishedTime={article?.publishedTime}
      modifiedTime={article?.modifiedTime}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Blog de ${siteName}`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd data={organizationSchema(settings, site)} />
    {schemaJsonLd && <JsonLd data={schemaJsonLd} />}
    {/* JSON-LD y metas específicas de cada página (p. ej. Schema Article) */}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-zift focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header header={header} siteName={siteName} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer footer={footer} settings={settings} />
    {settings.whatsapp && <WhatsAppButton phone={settings.whatsapp} />}
    <CookieConsent />
    <Analytics />
    <script>
      if (document.documentElement.classList.contains('js-reveal')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed')
                observer.unobserve(entry.target)
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        )
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el))

        // Imágenes que ya estaban completas cuando corrió este script
        document.querySelectorAll<HTMLImageElement>('img.img-fade').forEach((img) => {
          if (img.complete) img.classList.add('is-loaded')
        })
      }
    </script>
  </body>
</html>
