---
import { getMediaUrl, resolveMedia } from '@/lib/media'
import type { MediaRef } from '@ziftlab/types'

interface Props {
  media: MediaRef
  priority?: boolean
  sizes?: string
  class?: string
}

const { media, priority = false, sizes, class: className } = Astro.props

const doc = resolveMedia(media)
const src = getMediaUrl(media)
---

{
  doc && src && (
    <img
      src={src}
      alt={doc.alt}
      width={doc.width ?? undefined}
      height={doc.height ?? undefined}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      sizes={sizes}
      class:list={[!priority && 'img-fade', className]}
      onload={!priority ? "this.classList.add('is-loaded')" : undefined}
    />
  )
}
