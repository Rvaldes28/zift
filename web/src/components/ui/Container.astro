---
/** Ancho de lectura centrado. narrow = prosa, default = layout, wide = grids amplios. */
interface Props {
  size?: 'narrow' | 'default' | 'wide'
  class?: string
}

const { size = 'default', class: className } = Astro.props

const sizes = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
}
---

<div class:list={['mx-auto w-full px-6 md:px-8', sizes[size], className]}>
  <slot />
</div>
