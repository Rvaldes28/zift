---
/** Muro de logos de clientes en escala de grises, hairlines de índice. */
import MediaImage from '@/components/MediaImage.astro'
import type { Client } from '@ziftlab/types'

interface Props {
  clients: Client[]
  class?: string
}

const { clients, class: className } = Astro.props
---

{
  clients.length > 0 && (
    <ul
      class:list={[
        'grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-3 lg:grid-cols-6',
        className,
      ]}
      role="list"
    >
      {clients.map((client) => (
        <li class="group flex h-24 items-center justify-center bg-paper px-6">
          <MediaImage
            media={client.logo}
            class="max-h-10 w-auto opacity-70 grayscale transition duration-300 ease-zift group-hover:opacity-100 group-hover:grayscale-0"
            sizes="160px"
          />
        </li>
      ))}
    </ul>
  )
}
