---
/**
 * Meta tags de SEO: título, descripción, canónica, Open Graph y Twitter.
 * Recibe valores ya resueltos — BaseLayout mezcla los props de página con
 * los defaults de Ajustes del sitio. Va dentro de <head>.
 */
interface Props {
  title: string
  description?: string | undefined
  /** URL absoluta de la imagen para compartir (1200×630) */
  image?: string | null
  siteName: string
  noindex?: boolean
}

const { title, description, image, siteName, noindex = false } = Astro.props

// astro.config define `site` (PUBLIC_SITE_URL), así la canónica es absoluta
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_MX" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image} />}
