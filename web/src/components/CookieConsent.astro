---
/**
 * Banner de consentimiento de cookies (FASE 16). Panel ink no bloqueante,
 * abajo a la izquierda (hoja completa en móvil), con las tres opciones que
 * exige la AEPD en pie de igualdad: Aceptar todo y Rechazar todo idénticos,
 * y Configurar que despliega las categorías in situ. El bloqueo previo no
 * depende de este banner: BaseLayout fija Consent Mode en denied de forma
 * síncrona y aquí solo se registra la decisión (lib/consent.ts).
 *
 * Se reabre desde cualquier elemento con [data-cookie-settings]
 * (footer y política de cookies).
 */
---

<div
  data-cookie-consent
  hidden
  class="fixed inset-x-0 bottom-0 z-50 p-3 sm:inset-x-auto sm:bottom-5 sm:left-5 sm:w-full sm:max-w-md sm:p-0"
>
  <section
    tabindex="-1"
    aria-label="Preferencias de cookies"
    class="consent-card overflow-hidden rounded-lg border border-ink-line bg-ink text-white shadow-2xl"
  >
    <div class="p-5 sm:p-6">
      <p
        class="flex items-center gap-2.5 font-mono text-xs tracking-[0.18em] text-ink-muted uppercase"
      >
        <span class="size-2 shrink-0 bg-zift-glow" aria-hidden="true"></span>
        Cookies
      </p>

      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        Usamos cookies propias y de terceros para medir cómo se usa la web y, solo si algún día
        activas marketing, para publicidad. Las que no son necesarias quedan
        <strong class="font-medium text-white">bloqueadas hasta que decidas</strong>. Los detalles,
        en la <a href="/cookies" class="consent-link">política de cookies</a> y la
        <a href="/privacidad" class="consent-link">política de privacidad</a>.
      </p>

      <fieldset data-consent-panel hidden class="mt-5 border-t border-ink-line">
        <legend class="sr-only">Elige qué cookies permites</legend>

        <div class="flex items-center justify-between gap-4 border-b border-ink-line py-3.5">
          <div>
            <p class="text-sm font-medium">Necesarias</p>
            <p class="mt-0.5 text-xs leading-relaxed text-ink-muted">
              Seguridad del sitio y recordar esta elección.
            </p>
          </div>
          <span class="font-mono text-[10px] tracking-[0.14em] text-zift-glow uppercase">
            Siempre
          </span>
        </div>

        <label
          class="flex cursor-pointer items-center justify-between gap-4 border-b border-ink-line py-3.5"
        >
          <span>
            <span class="block text-sm font-medium">Analítica</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-ink-muted">
              Nos dice qué páginas funcionan (Google Analytics, Clarity).
            </span>
          </span>
          <input type="checkbox" name="analytics" class="consent-switch" />
        </label>

        <label class="flex cursor-pointer items-center justify-between gap-4 py-3.5">
          <span>
            <span class="block text-sm font-medium">Marketing</span>
            <span class="mt-0.5 block text-xs leading-relaxed text-ink-muted">
              Publicidad y remarketing. Hoy no usamos ninguna.
            </span>
          </span>
          <input type="checkbox" name="marketing" class="consent-switch" />
        </label>
      </fieldset>

      {/* Aceptar y Rechazar comparten estilo y tamaño: opciones equivalentes, sin empujar */}
      <div class="mt-5 grid grid-cols-2 gap-3">
        <button type="button" data-consent-accept class="consent-action">Aceptar todo</button>
        <button type="button" data-consent-reject class="consent-action">Rechazar todo</button>
        <button type="button" data-consent-save hidden class="consent-action col-span-2">
          Guardar preferencias
        </button>
      </div>

      <button
        type="button"
        data-consent-configure
        aria-expanded="false"
        class="mt-4 w-full cursor-pointer text-center font-mono text-xs tracking-[0.18em] text-ink-muted uppercase underline decoration-ink-line underline-offset-4 transition-colors hover:text-white"
      >
        Configurar cookies
      </button>
    </div>
  </section>
</div>

<style>
  /* Entrada del panel; la regla global de prefers-reduced-motion la anula */
  .consent-card {
    animation: consent-in 300ms ease-out both;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .consent-link {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 150ms;
  }
  .consent-link:hover {
    color: var(--color-zift-glow);
  }

  /* Sin clases de display de Tailwind: así el atributo hidden sí los oculta
     (gotcha conocido: inline-flex pisaría a hidden) */
  .consent-action {
    height: 2.75rem;
    padding-inline: 1rem;
    border-radius: 0.375rem; /* = rounded-md de Button.astro */
    border: 1px solid var(--color-ink-line);
    background: var(--color-ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-white);
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color 150ms,
      color 150ms;
  }
  .consent-action:hover {
    border-color: var(--color-zift-glow);
    color: var(--color-zift-glow);
  }

  .consent-switch {
    appearance: none;
    position: relative;
    width: 2.5rem;
    height: 1.375rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-ink-line);
    background: var(--color-ink-2);
    cursor: pointer;
    transition:
      background-color 150ms,
      border-color 150ms;
  }
  .consent-switch::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: var(--color-ink-muted);
    transition:
      transform 150ms,
      background-color 150ms;
  }
  .consent-switch:checked {
    background: var(--color-zift);
    border-color: var(--color-zift);
  }
  .consent-switch:checked::before {
    transform: translateX(1.125rem);
    background: var(--color-white);
  }
</style>

<script>
  import { readConsent, saveConsent } from '@/lib/consent'

  const root = document.querySelector<HTMLElement>('[data-cookie-consent]')

  if (root) {
    const card = root.querySelector<HTMLElement>('.consent-card')!
    const panel = root.querySelector<HTMLFieldSetElement>('[data-consent-panel]')!
    const analyticsBox = panel.querySelector<HTMLInputElement>('input[name="analytics"]')!
    const marketingBox = panel.querySelector<HTMLInputElement>('input[name="marketing"]')!
    const configureBtn = root.querySelector<HTMLButtonElement>('[data-consent-configure]')!
    const saveBtn = root.querySelector<HTMLButtonElement>('[data-consent-save]')!

    const setPanel = (open: boolean): void => {
      if (open) {
        const stored = readConsent()
        analyticsBox.checked = stored?.analytics ?? false
        marketingBox.checked = stored?.marketing ?? false
      }
      panel.hidden = !open
      saveBtn.hidden = !open
      configureBtn.setAttribute('aria-expanded', String(open))
    }

    const show = (withPanel: boolean): void => {
      setPanel(withPanel)
      root.hidden = false
    }

    const decide = (categories: { analytics: boolean; marketing: boolean }): void => {
      saveConsent(categories)
      root.hidden = true
    }

    root
      .querySelector('[data-consent-accept]')!
      .addEventListener('click', () => decide({ analytics: true, marketing: true }))
    root
      .querySelector('[data-consent-reject]')!
      .addEventListener('click', () => decide({ analytics: false, marketing: false }))
    saveBtn.addEventListener('click', () =>
      decide({ analytics: analyticsBox.checked, marketing: marketingBox.checked }),
    )
    configureBtn.addEventListener('click', () => setPanel(panel.hidden))

    // Cerrar con Escape no consiente nada: todo sigue bloqueado (denied)
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') root.hidden = true
    })

    // Reapertura desde el footer o la política de cookies
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest('[data-cookie-settings]')
      if (!trigger) return
      show(true)
      card.focus()
    })

    // Primera visita (o decisión borrada): pregunta; si ya decidió, silencio
    if (!readConsent()) show(false)
  }
</script>
