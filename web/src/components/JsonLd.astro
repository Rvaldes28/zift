---
/**
 * Bloque JSON-LD. Válido en <head> (con slot="head") o en el <body> — Google
 * lo lee en ambos. El escape de `<` evita que un "</script>" dentro del
 * contenido del CMS rompa el documento.
 */
import type { JsonLdObject } from '@/lib/schema'

interface Props {
  data: JsonLdObject
}

// `as Props`: en componentes sin elementos HTML (solo <script>) astro check
// no vincula la interfaz Props a Astro.props y lo deja como Record<string, any>
const { data } = Astro.props as Props
const json = JSON.stringify(data).replace(/</g, '\\u003c')
---

<script is:inline type="application/ld+json" set:html={json} />
