---
/**
 * Analítica (FASE 12): carga GA4 y Clarity SOLO tras consentimiento de
 * analítica — modo básico de Consent Mode, criterio AEPD; el default denied
 * inline de BaseLayout queda como segunda red. Sin IDs en web/.env no se
 * inyecta nada (dev limpio). También captura UTMs, pageviews/eventos propios
 * consentidos y delega clicks de CTA ([data-track-cta]) y WhatsApp.
 */
import type { SiteSetting } from '@ziftlab/types'

interface Props {
  externalScripts?: SiteSetting['externalScripts']
}

const { externalScripts = [] } = Astro.props

function configuredProvider(provider: string, envValue: string | undefined): string | undefined {
  const configured = externalScripts.find(
    (script) => script.provider === provider && script.enabled && script.id,
  )
  return configured?.id || envValue || undefined
}

const configuredGa4Id = configuredProvider('ga4', import.meta.env.PUBLIC_GA4_ID)
const configuredGtmContainerId = configuredProvider('gtm', import.meta.env.PUBLIC_GTM_CONTAINER_ID)
const configuredClarityId = configuredProvider('clarity', import.meta.env.PUBLIC_CLARITY_ID)
const configuredMetaPixelId = configuredProvider('meta_pixel', import.meta.env.PUBLIC_META_PIXEL_ID)
const configuredHotjarId = configuredProvider('hotjar', import.meta.env.PUBLIC_HOTJAR_ID)
const configuredGoogleAdsId = configuredProvider('google_ads', import.meta.env.PUBLIC_GOOGLE_ADS_ID)
const scriptConfigJson = JSON.stringify({
  clarityId: configuredClarityId,
  ga4Id: configuredGa4Id,
  googleAdsId: configuredGoogleAdsId,
  gtmContainerId: configuredGtmContainerId,
  hotjarId: configuredHotjarId,
  metaPixelId: configuredMetaPixelId,
}).replace(/</g, '\\u003c')
---

<script
  is:inline
  type="application/json"
  id="ziftlab-external-scripts"
  set:html={scriptConfigJson}
/>

<script>
  import { reportPerformance, track } from '@/lib/analytics'
  import { CONSENT_EVENT, readConsent, type StoredConsent } from '@/lib/consent'
  import { captureUtm } from '@/lib/utm'

  const scriptConfig = JSON.parse(
    document.getElementById('ziftlab-external-scripts')?.textContent || '{}',
  ) as {
    clarityId?: string
    ga4Id?: string
    googleAdsId?: string
    gtmContainerId?: string
    hotjarId?: string
    metaPixelId?: string
  }

  const GA4_ID = scriptConfig.ga4Id || undefined
  const GTM_CONTAINER_ID = scriptConfig.gtmContainerId || undefined
  const CLARITY_ID = scriptConfig.clarityId || undefined
  const META_PIXEL_ID = scriptConfig.metaPixelId || undefined
  const HOTJAR_ID = scriptConfig.hotjarId || undefined
  const GOOGLE_ADS_ID = scriptConfig.googleAdsId || undefined

  captureUtm()
  const startedAt = performance.now()
  let pageViewTracked = false
  let engagementTracked = false
  let performanceCaptureStarted = false

  // --- Carga consent-gated: nada de Google/Microsoft sin analytics granted ---

  let loaded = false
  let marketingLoaded = false

  const inject = (src: string): void => {
    const script = document.createElement('script')
    script.src = src
    script.async = true
    document.head.appendChild(script)
  }

  const loadVendors = (): void => {
    if (loaded) return
    loaded = true
    if (GA4_ID) {
      window.dataLayer ??= []
      // gtag exige `arguments`, como en lib/consent.ts
      function gtag(..._args: unknown[]) {
        window.dataLayer!.push(arguments as unknown as Record<string, unknown>)
      }
      gtag('js', new Date())
      gtag('config', GA4_ID)
      inject(`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`)
    }
    if (GTM_CONTAINER_ID) {
      window.dataLayer ??= []
      window.dataLayer.push({
        event: 'gtm.js',
        'gtm.start': Date.now(),
      })
      inject(`https://www.googletagmanager.com/gtm.js?id=${GTM_CONTAINER_ID}`)
    }
    if (CLARITY_ID) {
      // Equivalente tipado del snippet oficial: stub con cola + tag del proyecto
      window.clarity ??= Object.assign(
        function (...args: unknown[]) {
          ;(window.clarity!.q ??= []).push(args)
        },
        { q: [] as unknown[] },
      )
      inject(`https://www.clarity.ms/tag/${CLARITY_ID}`)
    }
  }

  const loadMarketingVendors = (): void => {
    if (marketingLoaded) return
    marketingLoaded = true

    if (HOTJAR_ID) inject(`https://static.hotjar.com/c/hotjar-${HOTJAR_ID}.js?sv=6`)

    if (GOOGLE_ADS_ID) {
      window.dataLayer ??= []
      function gtagAds(..._args: unknown[]) {
        window.dataLayer!.push(arguments as unknown as Record<string, unknown>)
      }
      gtagAds('js', new Date())
      gtagAds('config', GOOGLE_ADS_ID)
      inject(`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`)
    }

    if (META_PIXEL_ID) {
      type Fbq = ((...args: unknown[]) => void) & {
        loaded?: boolean
        queue?: unknown[]
        version?: string
      }
      const win = window as typeof window & {
        _fbq?: unknown
        fbq?: Fbq
      }
      if (!win.fbq) {
        const fbq = ((...args: unknown[]) => {
          ;(fbq.queue ??= []).push(args)
        }) as Fbq
        fbq.loaded = true
        fbq.version = '2.0'
        fbq.queue = []
        win.fbq = fbq
        win._fbq = fbq
      }
      win.fbq?.('init', META_PIXEL_ID)
      win.fbq?.('track', 'PageView')
      inject('https://connect.facebook.net/en_US/fbevents.js')
    }
  }

  if (readConsent()?.analytics) {
    if (GA4_ID || CLARITY_ID || GTM_CONTAINER_ID) {
      loadVendors()
    }
    trackPageView()
    startPerformanceCapture()
  }

  if (readConsent()?.marketing && (META_PIXEL_ID || HOTJAR_ID || GOOGLE_ADS_ID)) {
    loadMarketingVendors()
  }

  window.addEventListener(CONSENT_EVENT, (event) => {
    const consent = (event as CustomEvent<StoredConsent>).detail
    if (consent.analytics) {
      if (GA4_ID || CLARITY_ID || GTM_CONTAINER_ID) {
        if (loaded) window.clarity?.('start')
        else loadVendors()
      }
      trackPageView()
      startPerformanceCapture()
    } else {
      window.clarity?.('stop')
    }
    if (consent.marketing && (META_PIXEL_ID || HOTJAR_ID || GOOGLE_ADS_ID)) {
      loadMarketingVendors()
    }
  })

  function trackPageView(): void {
    if (pageViewTracked) return
    pageViewTracked = true
    track('page_view')
  }

  function trackEngagement(): void {
    if (engagementTracked || !pageViewTracked) return
    engagementTracked = true
    track('page_engagement', { duration_ms: Math.round(performance.now() - startedAt) })
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') trackEngagement()
  })
  window.addEventListener('pagehide', trackEngagement)

  // --- RUM tecnico: Web Vitals, recursos pesados y errores consentidos ---

  type ObservedEntry = PerformanceEntry & {
    duration?: number
    hadRecentInput?: boolean
    initiatorType?: string
    transferSize?: number
    value?: number
  }

  const reportedResources = new Set<string>()
  let latestLcp = 0
  let clsValue = 0
  let maxInp = 0
  let vitalsReported = false
  let loadReported = false

  function observePerformance(type: string, callback: (entry: ObservedEntry) => void): void {
    if (!('PerformanceObserver' in window)) return
    if (!PerformanceObserver.supportedEntryTypes?.includes(type)) return
    try {
      const observer = new PerformanceObserver((list) => {
        list.getEntries().forEach((entry) => callback(entry as ObservedEntry))
      })
      observer.observe({ buffered: true, type } as PerformanceObserverInit)
    } catch {
      // El navegador no soporta este entry type con buffered; seguimos con los demas.
    }
  }

  function reportLoadTiming(): void {
    if (loadReported) return
    loadReported = true
    const [navigation] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[]
    const value = navigation?.loadEventEnd
      ? navigation.loadEventEnd - navigation.startTime
      : performance.now() - startedAt
    reportPerformance('web_vital', {
      durationMs: Math.round(value),
      name: 'load',
      value: Math.round(value),
    })
  }

  function reportResource(entry: ObservedEntry): void {
    const transferSize = Number(entry.transferSize ?? 0)
    if (transferSize <= 500 * 1024) return
    if (reportedResources.has(entry.name)) return
    reportedResources.add(entry.name)
    reportPerformance('resource_timing', {
      initiatorType: entry.initiatorType,
      transferSize,
      url: entry.name,
      value: transferSize,
    })
  }

  function reportExistingHeavyResources(): void {
    ;(performance.getEntriesByType('resource') as PerformanceResourceTiming[]).forEach((entry) =>
      reportResource(entry),
    )
  }

  function reportVitals(): void {
    if (vitalsReported) return
    vitalsReported = true
    if (latestLcp > 0) {
      reportPerformance('web_vital', {
        durationMs: Math.round(latestLcp),
        name: 'LCP',
        value: Math.round(latestLcp),
      })
    }
    if (clsValue > 0) {
      reportPerformance('web_vital', { name: 'CLS', value: Number(clsValue.toFixed(4)) })
    }
    if (maxInp > 0) {
      reportPerformance('web_vital', {
        durationMs: Math.round(maxInp),
        name: 'INP',
        value: Math.round(maxInp),
      })
    }
    reportLoadTiming()
    reportExistingHeavyResources()
  }

  function startPerformanceCapture(): void {
    if (performanceCaptureStarted) return
    performanceCaptureStarted = true

    observePerformance('largest-contentful-paint', (entry) => {
      latestLcp = entry.startTime
    })
    observePerformance('layout-shift', (entry) => {
      if (!entry.hadRecentInput) clsValue += Number(entry.value ?? 0)
    })
    observePerformance('event', (entry) => {
      if (entry.duration && entry.duration > maxInp) maxInp = entry.duration
    })
    observePerformance('resource', reportResource)

    if (document.readyState === 'complete') {
      window.setTimeout(() => {
        reportLoadTiming()
        reportExistingHeavyResources()
      }, 0)
    } else {
      window.addEventListener(
        'load',
        () => {
          reportLoadTiming()
          reportExistingHeavyResources()
        },
        { once: true },
      )
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') reportVitals()
    })
    window.addEventListener('pagehide', reportVitals)

    window.addEventListener(
      'error',
      (event) => {
        const target = event.target instanceof HTMLElement ? event.target : null
        const resourceUrl = target
          ? (target.getAttribute('src') ?? target.getAttribute('href') ?? undefined)
          : undefined

        reportPerformance('client_error', {
          message: resourceUrl ? 'Resource load error' : event.message,
          metadata: {
            column: event.colno,
            filename: event.filename,
            line: event.lineno,
          },
          name: resourceUrl ? 'resource_error' : 'javascript_error',
          url: resourceUrl,
        })
      },
      true,
    )

    window.addEventListener('unhandledrejection', (event) => {
      reportPerformance('client_error', {
        message: event.reason instanceof Error ? event.reason.message : 'Unhandled rejection',
        name: 'unhandled_rejection',
      })
    })
  }

  // --- Delegación de clics: CTAs y WhatsApp (atributos data-track-*) ---

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    const cta = target?.closest<HTMLElement>('[data-track-cta]')
    if (cta) {
      track('cta_click', {
        label: cta.dataset.trackCta,
        location: cta.dataset.trackLocation,
        href: cta.getAttribute('href') ?? undefined,
      })
      return
    }
    const whatsapp = target?.closest<HTMLElement>('[data-track-whatsapp]')
    if (whatsapp) track('whatsapp_click', { location: whatsapp.dataset.trackWhatsapp })
  })
</script>
