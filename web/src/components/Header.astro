---
/**
 * Header del sitio con datos del global `header` de la API publica.
 * El menú móvil se abre con un script mínimo sin framework.
 */
import type { Header as HeaderGlobal } from '@ziftlab/types'

import MediaImage from '@/components/MediaImage.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import { resolveMedia } from '@/lib/media'

interface Props {
  header: HeaderGlobal
  siteName: string
}

const { header, siteName } = Astro.props

const navItems = header.navItems ?? []
const logo = resolveMedia(header.logo)
// El CTA es opcional: solo se pinta si label y href están completos
const cta =
  header.cta?.label && header.cta?.href
    ? { label: header.cta.label, href: header.cta.href, newTab: header.cta.newTab ?? false }
    : null

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur transition-shadow duration-300 ease-zift data-scrolled:shadow-lift"
>
  <Container>
    <div class="flex h-16 items-center justify-between gap-6">
      <a href="/" class="font-display text-xl" aria-label={`${siteName} — inicio`}>
        {
          logo ? (
            <MediaImage media={logo} priority class="h-8 w-auto" />
          ) : (
            <>
              {siteName}
              <span class="ml-1 inline-block size-2 bg-zift" aria-hidden="true" />
            </>
          )
        }
      </a>

      {
        navItems.length > 0 && (
          <nav class="hidden md:block" aria-label="Principal">
            <ul class="flex items-center gap-7">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.newTab ? '_blank' : undefined}
                    rel={item.newTab ? 'noopener noreferrer' : undefined}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={[
                      'relative py-1 text-sm font-medium transition-colors hover:text-ink',
                      'after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-zift after:transition-transform after:duration-300 after:ease-zift hover:after:scale-x-100',
                      isCurrent(item.href) ? 'text-ink after:scale-x-100' : 'text-muted',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="flex items-center gap-3">
        {
          /* En móvil el CTA vive dentro del panel del menú */
          cta && (
            <div class="hidden sm:block">
              <Button
                href={cta.href}
                size="sm"
                newTab={cta.newTab}
                data-track-cta={cta.label}
                data-track-location="header"
              >
                {cta.label}
              </Button>
            </div>
          )
        }
        <button
          type="button"
          class="inline-flex size-11 items-center justify-center rounded-md border border-line text-ink md:hidden"
          aria-expanded="false"
          aria-controls="nav-movil"
          data-nav-toggle
        >
          <span class="sr-only">Abrir menú</span>
          <svg
            class="size-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <nav
    id="nav-movil"
    class="animate-menu hidden border-t border-line bg-paper md:hidden"
    aria-label="Principal"
    data-nav-panel
  >
    <Container class="py-4">
      <ul class="flex flex-col">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.newTab ? '_blank' : undefined}
                rel={item.newTab ? 'noopener noreferrer' : undefined}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'block py-3 font-medium transition-colors hover:text-ink',
                  isCurrent(item.href) ? 'text-ink' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          cta && (
            <li class="pt-3">
              <Button
                href={cta.href}
                newTab={cta.newTab}
                class="w-full"
                data-track-cta={cta.label}
                data-track-location="header"
              >
                {cta.label}
              </Button>
            </li>
          )
        }
      </ul>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]')

  const setOpen = (open: boolean) => {
    panel?.classList.toggle('hidden', !open)
    toggle?.setAttribute('aria-expanded', String(open))
  }

  toggle?.addEventListener('click', () => {
    setOpen(panel?.classList.contains('hidden') ?? false)
  })

  // Cerrar con Escape devolviendo el foco al botón (teclado/a11y)
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.classList.contains('hidden')) {
      setOpen(false)
      toggle?.focus()
    }
  })

  // Sombra de elevación solo cuando el header despega del borde superior
  const header = document.querySelector<HTMLElement>('header')
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 4)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })
</script>
