# =============================================================
# ZiftLab — variables de entorno (ejemplo)
# Copiar los valores que apliquen a cms/.env y web/.env
# Nunca commitear .env reales. No usar estos valores en producción.
# =============================================================

# App
NODE_ENV=development

# Dashboard propio (va en admin/.env)
ADMIN_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_DATABASE_URL=postgresql://localhost:5432/ziftlab_admin_dev
ADMIN_SESSION_DAYS=14
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_IP_MAX_FAILED_ATTEMPTS=10
ADMIN_IP_WINDOW_MINUTES=15
ADMIN_IP_BLOCK_MINUTES=60
ADMIN_PASSWORD_MIN_LENGTH=12
ADMIN_ARGON2_MEMORY=65536
ADMIN_ARGON2_TIME=3
ADMIN_ARGON2_PARALLELISM=1
ADMIN_TOTP_ISSUER=ZiftLab
ADMIN_TOTP_ENCRYPTION_KEY=
ADMIN_2FA_CHALLENGE_MINUTES=5
ADMIN_ENFORCE_2FA_FOR_SENSITIVE=true
ADMIN_CSRF_SECRET=
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_PREVIEW_TOKEN=
LEADS_NOTIFY_EMAILS=
RESEND_FROM_EMAIL=
LEADS_CRM_WEBHOOK_URL=
LEADS_CRM_WEBHOOK_SECRET=
LEADS_CRM_AUTO_SEND=false

# Payload CMS (va en cms/.env)
PAYLOAD_SECRET=change_me_local_secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:4321

# Base de datos PostgreSQL local via Homebrew (va en cms/.env)
DATABASE_URL=postgresql://localhost:5432/ziftlab_dev

# Astro (va en web/.env)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:3000
PUBLIC_CONTENT_API_URL=http://localhost:3000
PUBLIC_ANALYTICS_ENABLED=true

# MinIO local — storage S3-compatible para media (se usa desde FASE 1)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=payload-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PREFIX=admin-media
S3_PUBLIC_BASE_URL=

# Email transaccional (futuro: Resend / Brevo / Amazon SES)
RESEND_API_KEY=
BREVO_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analítica propia y proveedores externos
ANALYTICS_EVENT_SALT=
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_HOTJAR_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_ADS_CUSTOMER_ID=
